# TILA Backend Environment Configuration

# =========================================
# LLM GATEWAY CONFIGURATION
# =========================================

# Main LLM Provider and Model Selection
MAIN_LLM_PROVIDER=groq
MAIN_LLM_MODEL=llama-3.1-8b-instant
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.0-flash

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Environment
ENVIRONMENT=development
PORT=8000

# =========================================
# MONGODB (Atlas or local)
# =========================================
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tila

# =========================================
# AUTH (FastAPI Users — cookie + database strategy)
# =========================================
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_MAX_AGE=604800
AUTH_COOKIE_NAME=tilaauth
CSRF_COOKIE_NAME=csrftoken
CSRF_HEADER_NAME=x-csrftoken
CORS_ORIGINS=http://localhost:4200
